# Stage 1: builder, trains the model
FROM python:3.10-slim AS builder

WORKDIR /build
COPY requirements-train.txt .
RUN pip install --no-cache-dir --target=/build/deps -r requirements-train.txt
ENV PYTHONPATH=/build/deps
# will import pandas, sklearn and joblib from /build/deps

COPY generate_dataset.py train.py ./
RUN python generate_dataset.py && python train.py
# can now find /build/model.joblib

# Stage 2: runtime
FROM python:3.10-slim
# smaller image

WORKDIR /app
COPY requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt
# packages needed to run the API

COPY --from=builder /build/model.joblib .
COPY main.py .

EXPOSE 5000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]