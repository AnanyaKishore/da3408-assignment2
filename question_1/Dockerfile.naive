FROM python:3.10-slim

WORKDIR /app

COPY requirements-train.txt requirements-serve.txt ./
RUN pip install --no-cache-dir -r requirements-train.txt -r requirements-serve.txt

COPY generate_dataset.py train.py main.py ./
RUN python generate_dataset.py && python train.py

EXPOSE 5000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]